# Flask
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=generate-a-safe-random-key
JWT_SECRET_KEY=generate-another-safe-random-key

# Database (for Supabase, use the Transaction Pooler URL on port 6543)
DATABASE_URL=postgresql://user:password@host:6543/postgres

# First super admin, created on startup if missing.
# Required in production; in development it defaults to admin@maumart.com / Admin123!
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=choose-a-strong-password

# Frontend URL (for CORS and Socket.IO)
FRONTEND_URL=http://localhost:5173

# Public URL of this API (used for links to locally stored uploads)
BACKEND_URL=http://localhost:5000

# Email: Resend (default provider; switch to SMTP in Admin > Email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# SMTP fallback (optional; the admin panel's Email page overrides these)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@yourdomain.com

# Supabase Storage (recommended in production; falls back to local disk if unset)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
